// Standalone example. MERGE into an existing policy; never overwrite one blindly.
{
  "tagOwners": {
    "tag:portal": ["owner@"],
    "tag:server": ["owner@"],
    "tag:owner": ["owner@"]
  },
  "acls": [
    {"action":"accept","src":["tag:portal"],"dst":["tag:server:22"]},
    {"action":"accept","src":["tag:owner"],"dst":["tag:server:22","tag:portal:22"]}
  ]
}
