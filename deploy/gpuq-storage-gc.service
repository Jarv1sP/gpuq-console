[Unit]
Description=GPUQ verified dataset cache reclamation (opt-in)
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 %h/.local/libexec/gpuq-console/node-executor.py --storage-collect
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
CPUQuota=100%
MemoryMax=2G
TasksMax=32
Nice=10
IOSchedulingClass=idle
