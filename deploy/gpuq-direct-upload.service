[Unit]
Description=GPUQ scoped campus upload data plane (opt-in)
After=network-online.target
[Service]
ExecStart=/usr/bin/python3 %h/.local/libexec/gpuq-console/node-executor.py --direct-upload-daemon
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
CPUQuota=200%
MemoryMax=512M
TasksMax=24
[Install]
WantedBy=default.target
