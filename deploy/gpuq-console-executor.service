[Unit]
Description=GPUQ Console restricted execution bridge
After=network-online.target

[Service]
ExecStart=/usr/bin/python3 /opt/gpuq-console/executor/execution-worker.py
Restart=on-failure
RuntimeDirectory=gpuq-console-executor
RuntimeDirectoryMode=0750
# The portal bind-mounts this directory; preserve its inode across stop/start.
RuntimeDirectoryPreserve=yes
Group=1000
UMask=0007
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/run/gpuq-console-executor
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryMax=128M
TasksMax=64

[Install]
WantedBy=multi-user.target
