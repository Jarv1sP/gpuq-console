{$PORTAL_DOMAIN} {
    encode zstd gzip
    reverse_proxy gpuq-console:8080 {
        # Portal has a short idle timeout. Do not reuse an upstream socket
        # which may be closed during a rollout or between upload chunks.
        transport http {
            keepalive off
        }
        header_up X-Real-IP {remote_host}
    }
}
{$HEADSCALE_DOMAIN} {
    reverse_proxy headscale:8080
}
