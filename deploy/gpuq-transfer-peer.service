[Unit]
Description=GPUQ read-only LAN snapshot peer (opt-in)
After=network-online.target
[Service]
ExecStart=/usr/bin/python3 %h/.local/libexec/gpuq-console/node-executor.py --transfer-peer-daemon
Restart=on-failure
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
CPUQuota=200%
MemoryMax=2G
TasksMax=32
[Install]
WantedBy=default.target
