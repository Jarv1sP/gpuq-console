[Unit]
Description=GPUQ bounded diagnostic retention and orphan cleanup

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 %h/.local/libexec/gpuq-console/job-diagnostics.py --gc
MemoryMax=128M
CPUQuota=10%
TasksMax=16
IOWeight=10
TimeoutStartSec=300
TimeoutStopSec=15
KillMode=control-group
NoNewPrivileges=true
UMask=0077
StandardOutput=null
StandardError=journal
